compile_commands.json

# Game data must never be committed. Users supply their own ROM; extracted
# assets belong in the per-user data directory, not in the repository.
*.nds
*.srl
*.sav
*.dsv
/extracted/
/romfs/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Program code extracted from a ROM, and anything translated from it, is the
# game's copyrighted code. It belongs in the user data directory.
arm9.bin
arm7.bin
overlay9_*.bin
overlay7_*.bin

# Python
__pycache__/
*.pyc
