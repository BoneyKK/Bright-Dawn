  "parts": [
    {
      "part": "rom",
      "status": "done",
      "now": "Checks the ROM, reads its file system, archives and every kind of compression the game uses."
    },
    {
      "part": "assets",
      "status": "part",
      "now": "Decodes the menus' pictures and the game's font (NFTR) for the launcher. Textures, models and sounds: not yet."
    },
    {
      "part": "mods",
      "status": "none",
      "now": "Planned: replace game files without changing the ROM."
    },
    {
      "part": "translator",
      "status": "done",
      "now": "Translates 17,076 functions of the game's code to C++, on your computer, with interrupt polls and instruction counts."
    },
    {
      "part": "game builder",
      "status": "done",
      "now": "Downloads its compiler (and Python on Windows) for the build and deletes it after. The downloaded compiler is not yet tried on a real build."
    },
    {
      "part": "game library",
      "status": "done",
      "now": "Builds, loads and runs: reaches the name entry like the interpreted game, about twice as fast (600 frames in 11 s instead of 24)."
    },
    {
      "part": "runtime",
      "status": "done",
      "now": "Runs translated code with the interpreter behind it. Interrupts are taken where translated code polls for them. Calls that never return no longer pile up until the program crashes (the Windows crash after about 7 minutes)."
    },
    {
      "part": "nds",
      "status": "part",
      "now": "The console model runs the game to its name entry. The game's save is kept between runs. No music, beyond the name entry not yet tried."
    },
    {
      "part": "gfx",
      "status": "done",
      "now": "Both screens in one window, any size, stacked or side by side, sharp pixels with smooth edges. Drawn through Vulkan, or the system's renderer where there is none. Widescreen and sharper 3D: not yet."
    },
    {
      "part": "audio",
      "status": "none",
      "now": "The sound hardware is modelled, but nothing plays it to your speakers."
    },
    {
      "part": "input",
      "status": "done",
      "now": "Keyboard, any number of controllers, the mouse as the stylus."
    },
    {
      "part": "ui, app",
      "status": "done",
      "now": "Setup and launcher look like the game's settings menu: its board, ribbon, parchment, buttons, message bar and font, from your ROM. Settings book, pause menu."
    },
    {
      "part": "platform, core",
      "status": "done",
      "now": "Window, files, settings, frame timing, log, checksums. A crash is noted with where it happened; a game that stops finishing frames too."
    },
    {
      "part": "CI and releases",
      "status": "done",
      "now": "Every change is built and tested on Linux and Windows; green changes on main become a pre-release. Its description gives the state first, then the big changes since the last one."
    }
